## Cell 4 — Build the State Graph (All TODOs Filled In + DEMO_MODE)

```python
# Cell 4 — Build the state graph
# Complete each TODO below. Hints reference the LangGraph docs.

sys.path.append(str(pathlib.Path.cwd().parent / "implementation"))

from node import create_plan, create_code
from prompts import PLANNER_SYSTEM, CODER_SYSTEM, ERROR_RETRY_SYSTEM

# DEMO_MODE forces the first Coder attempt to produce broken code,
# guaranteeing a visible retry cycle in the terminal output.
DEMO_MODE = os.getenv("DEMO_MODE", "off") == "mock"


# ---------------------------------------------------------------------------
# TODO 1: Define the State TypedDict
# Hint: TypedDict gives LangGraph a schema to validate state updates.
# Fields needed: jira_ticket, plan, generated_code,
#                execution_output, error, retry_count
# ---------------------------------------------------------------------------
class CoderState(TypedDict):
    jira_ticket: str
    plan: str
    generated_code: str
    execution_output: str
    error: Optional[str]
    retry_count: int


# ---------------------------------------------------------------------------
# TODO 2: Write the planner node
# Hint: A node is a function (state: YourState) -> YourState.
#       Call llm.invoke([SystemMessage(...), HumanMessage(...)]) and
#       return {**state, 'plan': response.content.strip()}
# ---------------------------------------------------------------------------
def planner(state: CoderState) -> CoderState:
    """Call GPT-4o with PLANNER_SYSTEM and the jira_ticket, store result in 'plan'."""
    plan = create_plan(llm, state["jira_ticket"])
    return {**state, "plan": plan}


# ---------------------------------------------------------------------------
# TODO 3: Write the coder node
# Hint: Check state['error'] — if set, use the retry prompt that
#       injects the traceback. Otherwise use the standard coder prompt.
#       Strip markdown fences if the model adds them despite your prompt.
# ---------------------------------------------------------------------------
def coder(state: CoderState) -> CoderState:
    """Call GPT-4o to write Python code; handle both first-attempt and retry."""

    # DEMO_MODE: force the very first attempt to be broken code,
    # so the retry cycle is guaranteed to appear in the output.
    if DEMO_MODE and state.get("retry_count", 0) == 0 and not state.get("error"):
        broken_code = (
            "def main():\n"
            "    total = 0\n"
            "    for i in range(10)\n"   # missing colon -> guaranteed SyntaxError
            "        total += i\n"
            "    print(total)\n\n"
            "main()\n"
        )
        print("[CODER] DEMO_MODE active — injecting deliberately broken code.")
        return {**state, "generated_code": broken_code}

    if state.get("error"):
        system_msg = ERROR_RETRY_SYSTEM
        human_msg = (
            f"Implementation plan:\n{state['plan']}\n\n"
            f"Previous code:\n{state['generated_code']}\n\n"
            f"Traceback:\n{state['error']}"
        )
    else:
        system_msg = CODER_SYSTEM
        human_msg = f"Implementation plan:\n{state['plan']}"

    code = create_code(llm, system_msg, human_msg)
    return {**state, "generated_code": code}


# ---------------------------------------------------------------------------
# TODO 4: Write the compiler node
# Hint: Write generated_code to a tempfile, run subprocess.run(
#       [sys.executable, tmp_path], capture_output=True, timeout=30)
#       Check result.returncode; store error or execution_output.
# ---------------------------------------------------------------------------
def compiler(state: CoderState) -> CoderState:
    """Execute generated_code; store stdout or traceback."""
    print("\n[COMPILER] Executing generated code...")

    tmp_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", suffix=".py", delete=False
        ) as tmp:
            tmp.write(state["generated_code"])
            tmp_path = tmp.name

        result = subprocess.run(
            [sys.executable, tmp_path],
            capture_output=True,
            text=True,
            timeout=30,
        )

        if result.returncode == 0:
            print(f"[COMPILER] SUCCESS. Output:\n{result.stdout}")
            return {**state, "execution_output": result.stdout, "error": None}
        else:
            print(f"[COMPILER] FAILED. Traceback:\n{result.stderr}")
            return {**state, "execution_output": "", "error": result.stderr}

    except subprocess.TimeoutExpired:
        print("[COMPILER] TIMEOUT after 30 seconds.")
        return {
            **state,
            "execution_output": "",
            "error": "TimeoutExpired: execution exceeded 30 seconds.",
        }
    finally:
        if tmp_path and os.path.exists(tmp_path):
            os.unlink(tmp_path)


# ---------------------------------------------------------------------------
# TODO 5: Write the error_handler node
# Hint: This node just increments retry_count and prints a message.
#       Return {**state, 'retry_count': state['retry_count'] + 1}
# ---------------------------------------------------------------------------
def error_handler(state: CoderState) -> CoderState:
    """Increment retry_count so the coder knows it's a retry."""
    new_count = state["retry_count"] + 1
    print(f"\n[ERROR_HANDLER] Retry {new_count}/3 triggered. Routing back to CODER.")
    return {**state, "retry_count": new_count}


# ---------------------------------------------------------------------------
# TODO 6: Write the conditional edge function
# Hint: Return a string matching one of the keys in the mapping dict
#       you'll pass to add_conditional_edges().
#       Logic: if error AND retry_count < 3 -> 'error_handler' else -> 'end'
# ---------------------------------------------------------------------------
def should_retry(state: CoderState) -> str:
    """Decide whether to retry or end."""
    if state.get("error") and state["retry_count"] < 3:
        return "error_handler"
    return "end"


# ---------------------------------------------------------------------------
# TODO 7: Assemble the StateGraph
# Hint:
#   graph = StateGraph(CoderState)
#   graph.add_node('planner', planner)        # register each node
#   graph.add_edge('planner', 'coder')         # linear edge
#   graph.add_conditional_edges('compiler', should_retry, {...})
#   graph.set_entry_point('planner')
#   app = graph.compile()
# ---------------------------------------------------------------------------
def build_graph():
    """Build and compile the StateGraph."""
    graph = StateGraph(CoderState)

    graph.add_node("planner", planner)
    graph.add_node("coder", coder)
    graph.add_node("compiler", compiler)
    graph.add_node("error_handler", error_handler)

    graph.set_entry_point("planner")
    graph.add_edge("planner", "coder")
    graph.add_edge("coder", "compiler")
    graph.add_conditional_edges(
        "compiler",
        should_retry,
        {"error_handler": "error_handler", "end": END},
    )
    graph.add_edge("error_handler", "coder")

    app = graph.compile()
    return app


print("Node and graph functions defined. Proceed to Cell 5 to run.")
```

