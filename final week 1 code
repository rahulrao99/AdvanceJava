## Cell 5 — Run the Pipeline (Normal / Happy Path)

```python
# Cell 5 — Run the pipeline
# Pick a ticket index (0, 1, or 2) from TICKETS defined in Cell 3.

SELECTED_TICKET_INDEX = 0  # Change this to try a different ticket

ticket = TICKETS[SELECTED_TICKET_INDEX]
ticket_text = f"[{ticket['id']}] {ticket['summary']}\n{ticket['description']}"

print(f'Running pipeline for ticket: {ticket["id"]} — {ticket["summary"]}')
print('=' * 60)

# Build the graph (calls your build_graph() from Cell 4)
app = build_graph()

# Seed state
initial_state: CoderState = {
    'jira_ticket': ticket_text,
    'plan': '',
    'generated_code': '',
    'execution_output': '',
    'error': None,
    'retry_count': 0,
}

final_state = app.invoke(initial_state)

print('\n' + '=' * 60)
if final_state.get('error'):
    print('PIPELINE FAILED after max retries.')
    print('Last error:', final_state['error'])
else:
    print(f'PIPELINE SUCCEEDED (retries: {final_state["retry_count"]})')
    print('\nOutput:\n', final_state['execution_output'])

print('\n--- Generated Code ---')
print(final_state['generated_code'])
