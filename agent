import asyncio
import json
import os
import sys

from dotenv import load_dotenv
from openai import OpenAI

from mcp import ClientSession
from mcp.client.stdio import stdio_client, StdioServerParameters

load_dotenv()

client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])

# ------------------------------------------------------------------------
# System prompt
# ------------------------------------------------------------------------
# This is the agent's instruction manual. The two most important lines
# are the ones that FORCE exploration before code generation — without
# them, the model will happily "fix" a file it has never actually read.
SYSTEM_PROMPT = """You are an autonomous code-fixing agent with access to a sandboxed
file workspace through MCP tools: list_files, read_file, and write_file.

Your job: find Python files in the workspace, identify bugs in them, fix
those bugs, and write the corrected versions to the "fixed/" subfolder —
WITHOUT ever modifying the original files.

Rules you MUST follow:
1. You MUST call list_files before doing anything else, to see what exists.
2. You MUST call read_file on each relevant Python file BEFORE writing any
   fix for it. Never guess at a file's contents or invent a fix for code
   you have not read.
3. When you find a bug, write the corrected file to "fixed/<original_filename>"
   using write_file. Never overwrite the original file.
4. Keep fixes minimal and targeted — fix only the actual bug, do not rewrite
   unrelated logic or restyle the code.
5. Once you have read every relevant file and written every fix, respond
   with a final plain-text summary of what you found and fixed. Do not call
   any more tools after that.
"""

DEFAULT_TASK = "Look at the existing codebase and identify any bugs, fix them, and write the fixed versions to the fixed/ folder."


def mcp_tools_to_openai_format(mcp_tools) -> list[dict]:
    """
    Convert the tool definitions returned by session.list_tools() into the
    format the OpenAI Chat Completions API expects for function calling.

    MCP's inputSchema is already a JSON Schema (auto-generated by FastMCP
    from the server's type hints/docstrings), so we can pass it straight
    through as the function's "parameters" — no manual re-declaration needed.
    """
    openai_tools = []
    for tool in mcp_tools.tools:
        openai_tools.append(
            {
                "type": "function",
                "function": {
                    "name": tool.name,
                    "description": tool.description or "",
                    "parameters": tool.inputSchema,
                },
            }
        )
    return openai_tools


async def run_agent(task: str):
    server_params = StdioServerParameters(
        command="python",
        args=["mcp_server.py"],
    )

    print(f"[Agent] Connecting to MCP server: mcp_server.py")
    print(f"[Agent] Task: {task}\n")

    async with stdio_client(server_params) as (read_stream, write_stream):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()

            mcp_tools = await session.list_tools()
            tool_names = [t.name for t in mcp_tools.tools]
            print("-" * 70)
            print(f"[Agent] Discovered {len(tool_names)} tools:")
            for t in mcp_tools.tools:
                print(f"  - {t.name}: {t.description.strip().splitlines()[0]}")
            print("-" * 70 + "\n")

            openai_tools = mcp_tools_to_openai_format(mcp_tools)

            messages = [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": task},
            ]

            iteration = 0
            max_iterations = 20  # safety cap against infinite tool-call loops

            while iteration < max_iterations:
                iteration += 1
                print(f"[Agent] === Iteration {iteration} ===")

                response = client.chat.completions.create(
                    model="gpt-4o",
                    messages=messages,
                    tools=openai_tools,
                    tool_choice="auto",
                )

                choice = response.choices[0]
                message = choice.message

                # No more tool calls -> the model is done, print its summary and stop.
                if not message.tool_calls:
                    print("[Agent] Final Response:")
                    print("=" * 70)
                    print(message.content)
                    print("=" * 70)
                    print("\n>> Take a screenshot of output like this for your submission. <<")
                    return

                # Append the assistant's tool-call request to the conversation
                # so the model retains context on subsequent turns.
                messages.append(message.model_dump(exclude_none=True))

                # Execute every requested tool call through the real MCP server.
                for tool_call in message.tool_calls:
                    tool_name = tool_call.function.name
                    try:
                        args = json.loads(tool_call.function.arguments or "{}")
                    except json.JSONDecodeError:
                        args = {}

                    print(f"[MCP] Calling '{tool_name}' with args: {args}")

                    result = await session.call_tool(tool_name, args)
                    result_text = "".join(
                        block.text for block in result.content if hasattr(block, "text")
                    )

                    preview = result_text[:150].replace("\n", " ")
                    print(f"[MCP] Result preview: {preview}...\n")

                    messages.append(
                        {
                            "role": "tool",
                            "tool_call_id": tool_call.id,
                            "content": result_text,
                        }
                    )

            print("[Agent] Reached max iterations without a final answer. Stopping.")


if __name__ == "__main__":
    task_arg = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else DEFAULT_TASK
    asyncio.run(run_agent(task_arg))
