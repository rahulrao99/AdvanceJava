import java.util.*;

// ╔══════════════════════════════════════════════════════════════════╗
//  QUESTION 2 — PAYMENT TRANSACTION MONITORING
// ╚══════════════════════════════════════════════════════════════════╝


// Creating an enum to represent only 2 valid transaction types
enum TransactionType {
    
    // CREDIT means money added into account
    CREDIT,

    // DEBIT means money deducted from account
    DEBIT
}


// Transaction class represents one banking transaction
class Transaction {

    // transactionId = unique id of transaction
    // accountId = account to which transaction belongs
    int transactionId, accountId;

    // type stores whether transaction is CREDIT or DEBIT
    TransactionType type;

    // amount stores money involved in transaction
    double amount;

    // timestampSec stores time in unix seconds
    long timestampSec;

    
    // Constructor to initialise transaction object
    Transaction(int tid, int aid, TransactionType type, double amount, long ts) {

        // Assigning constructor values to object variables
        this.transactionId = tid;
        this.accountId = aid;

        this.type = type;
        this.amount = amount;

        this.timestampSec = ts;
    }

    
    // Getter method to return accountId
    public int getAccountId() {
        return accountId;
    }

    
    // Getter method to return transaction type
    public TransactionType getType() {
        return type;
    }

    
    // Getter method to return amount
    public double getAmount() {
        return amount;
    }

    
    // Getter method to return timestamp
    public long getTimestampSec() {
        return timestampSec;
    }
}


// AccountManager class manages all account transactions
class AccountManager {

    // Creating a list to store all transactions
    List<Transaction> transactions = new ArrayList<>();


    // Method to add new transaction into list
    void addTransaction(Transaction tx) {

        // Adding transaction object into transaction list
        transactions.add(tx);
    }


    // Method to calculate account balance
    public double getBalance(int accountId) {

        // Variable to store final balance
        double balance = 0.0;

        
        // Adding for loop to iterate through all transactions
        for (Transaction tx : transactions) {

            
            // Adding if condition to check whether transaction belongs to requested account
            if (tx.accountId == accountId) {

                
                // Adding if condition to check if transaction is CREDIT
                if (tx.type == TransactionType.CREDIT)

                    // CREDIT means money added to balance
                    balance += tx.amount;

                else

                    // DEBIT means money deducted from balance
                    balance -= tx.amount;
            }
        }

        
        // Returning final calculated balance
        return balance;
    }


    // Method to calculate average transaction amount per account
    public Map<Integer, Double> getAverageTransactionAmountByAccount() {

        
        // Creating map to store total amount per account
        Map<Integer, Double> sumMap = new HashMap<>();

        
        // Creating map to store transaction count per account
        Map<Integer, Integer> countMap = new HashMap<>();


        // Adding for loop to iterate through all transactions
        for (Transaction tx : transactions) {

            
            // Adding current transaction amount into sumMap
            sumMap.put(
                tx.getAccountId(),

                
                // getOrDefault returns existing sum else 0.0 if key not present
                sumMap.getOrDefault(tx.getAccountId(), 0.0)
                        + tx.getAmount()
            );


            
            // Increasing transaction count for that account
            countMap.put(
                tx.getAccountId(),

                
                // getOrDefault returns existing count else 0
                countMap.getOrDefault(tx.getAccountId(), 0)
                        + 1
            );
        }


        
        // Creating final result map to store averages
        Map<Integer, Double> result = new HashMap<>();


        
        // Adding for loop to iterate through all account ids in sumMap
        for (int id : sumMap.keySet()) {

            
            // Calculating average = total amount / count
            result.put(
                id,
                sumMap.get(id) / countMap.get(id)
            );
        }


        
        // Returning final average map
        return result;
