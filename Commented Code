// Course class represents one obstacle course
class Course {

    // Variable to store course title
    String title;

    // Variable to store total number of obstacles
    int obstacleCount;

    // Constructor to initialize course details
    Course(String title, int count) {

        // Assigning course title
        this.title = title;

        // Assigning obstacle count
        this.obstacleCount = count;
    }

    // Overriding equals method to compare Course objects logically
    @Override
    public boolean equals(Object o) {

        // Checking if object is not instance of Course
        if (!(o instanceof Course))

            // Returning false because object type is different
            return false;

        // Typecasting Object into Course object
        Course c = (Course) o;

        // Comparing title and obstacle count
        return c.title.equals(this.title)
            && c.obstacleCount == this.obstacleCount;
    }

    // Overriding hashCode because equals is overridden
    @Override
    public int hashCode() {

        // Generating hash code using title and obstacle count
        return title.hashCode() * obstacleCount;
    }
}


// Run class represents one attempt of completing the course
class Run {

    // Variable to store course object
    Course course;

    // Boolean to track whether run is completed
    boolean complete;

    // List to store obstacle completion times
    List<Integer> obstacleTimes;

    // Constructor to initialize run
    Run(Course c) {

        // Assigning course object
        course = c;

        // Initially marking run as incomplete
        complete = false;

        // Creating empty list for obstacle times
        obstacleTimes = new ArrayList<>();
    }


    // Method to add obstacle completion time
    void addObstacleTime(int t) {

        // Checking if run already completed
        if (complete)

            // Throwing exception because no more obstacles can be added
            throw new IllegalStateException("run is full");

        // Adding obstacle time into list
        obstacleTimes.add(t);

        // Checking if all obstacles are completed
        if (obstacleTimes.size() == course.obstacleCount)

            // Marking run as complete
            complete = true;
    }


    // Method to calculate total run time
    int getRunTime() {

        // Using stream to sum all obstacle times
        return obstacleTimes
                .stream()
                .mapToInt(Integer::intValue)
                .sum();
    }
}



// RunCollection class manages all runs for one course
class RunCollection {

    // Variable to store course
    Course course;

    // List to store all runs
    List<Run> runs = new ArrayList<>();

    // Constructor to initialize RunCollection
    RunCollection(Course c) {

        // Assigning course
        course = c;
    }


    // Method to add run into collection
    void addRun(Run run) {

        // Checking if run belongs to same course
        if (!run.course.equals(course))

            // Throwing exception if course mismatches
            throw new IllegalArgumentException("Course mismatch");

        // Adding run into list
        runs.add(run);
    }


    // Method to return total number of runs
    int getNumRuns() {

        // Returning list size
        return runs.size();
    }



    // ── TASK 1: personalBest() ──────────────────────────

    // Method to find best completed run using stream
    public int personalBest() {

        // Using stream to process all runs
        return runs.stream()

            // Filtering only completed runs
            .filter(r -> r.complete)

            // Converting runs into runtime values
            .mapToInt(r -> r.getRunTime())

            // Finding minimum runtime
            .min()

            // Returning Integer.MAX_VALUE if no completed run exists
            .orElse(Integer.MAX_VALUE);
    }



    // Alternative implementation using for loop
    public int personalBest_ForLoop() {

        // Initializing best time with maximum integer value
        int best = Integer.MAX_VALUE;

        // Adding loop to iterate through all runs
        for (Run run : runs) {

            // Checking if run is incomplete
            if (!run.complete)

                // Skipping incomplete runs
                continue;

            // Comparing current runtime with best runtime
            if (run.getRunTime() < best)

                // Updating best runtime
                best = run.getRunTime();
        }

        // Returning final best runtime
        return best;
    }



    // ── TASK 2: bestOfBests() ──────────────────────────

    // Method to calculate best obstacle times combined from all runs
    public int bestOfBests() {

        // Variable to store final total
        int total = 0;

        // Outer loop to iterate through obstacle positions
        for (int i = 0; i < course.obstacleCount; i++) {

            // Initializing minimum time for current obstacle
            int obstacleMin = Integer.MAX_VALUE;

            // Inner loop to iterate through all runs
            for (Run run : runs) {

                // Guard condition to avoid IndexOutOfBoundsException
                if (run.obstacleTimes.size() > i) {

                    // Updating minimum obstacle time
                    obstacleMin =
                        Math.min(
                            obstacleMin,
                            run.obstacleTimes.get(i)
                        );
                }
            }

            // Adding best obstacle time into total
            total += obstacleMin;
        }

        // Returning final total
        return total;
    }



    // ── TASK 3: chanceOfPersonalBest() ──────────────────────────

    // Monte Carlo simulation method
    public double chanceOfPersonalBest(Run inProgress) {

        // Getting personal best runtime
        int personalBest = personalBest();

        // Getting total obstacle count
        int totalObstacles = course.obstacleCount;


        // Creating historical data structure
        List<List<Integer>> historical =
            new ArrayList<>();


        // Creating list for each obstacle
        for (int i = 0; i < totalObstacles; i++)

            // Adding empty list for obstacle i
            historical.add(new ArrayList<>());


        // Looping through all runs
        for (Run run : runs)

            // Looping through obstacle times of current run
            for (int i = 0; i < run.obstacleTimes.size(); i++)

                // Storing historical obstacle times
                historical.get(i).add(
                    run.obstacleTimes.get(i)
                );


        // Getting current runtime of in-progress run
        int currentTotal =
            inProgress.getRunTime();

        // Getting completed obstacle count
        int completedObstacles =
            inProgress.obstacleTimes.size();


        // Checking if already slower than personal best
        if (currentTotal > personalBest)

            // Returning 0 probability
            return 0.0;


        // Setting total simulation count
        int trials = 10000;

        // Variable to count successful simulations
        int success = 0;

        // Creating Random object
        Random random = new Random();


        // Loop for running Monte Carlo trials
        for (int t = 0; t < trials; t++) {

            // Initializing simulated total with current total
            int simTotal = currentTotal;


            // Looping through remaining obstacles
            for (int j = completedObstacles;
                 j < totalObstacles;
                 j++) {

                // Selecting random historical time
                simTotal +=
                    historical.get(j).get(
                        random.nextInt(
                            historical.get(j).size()
                        )
                    );

                // Checking if simulation already exceeded personal best
                if (simTotal > personalBest)

                    // Stopping current simulation early
                    break;
            }


            // Checking if simulation beat personal best
            if (simTotal <= personalBest)

                // Incrementing success counter
                success++;
        }


        // Returning probability
        return success / (double) trials;
    }
}



