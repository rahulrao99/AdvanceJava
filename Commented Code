// LogEntry class is responsible for parsing and storing one log record
class LogEntry {

    // Storing timestamp as String from input log
    private final String timestamp;

    // Storing vehicle number plate
    private final String licensePlate;

    // Storing booth type like ENTRY / EXIT / MAINROAD
    private final String boothType;

    // Storing highway location in KM
    private final int location;

    // Storing direction EAST or WEST
    private final String direction;

    // Constructor to parse each log line
    LogEntry(String logLine) {

        // Splitting input string using spaces
        String[] tokens = logLine.split(" ");

        // Assigning timestamp from first token
        this.timestamp = tokens[0];

        // Assigning license plate from second token
        this.licensePlate = tokens[1];

        // Assigning booth type from fourth token
        this.boothType = tokens[3];

        // Extracting numeric location by removing last direction character
        this.location =
            Integer.parseInt(tokens[2].substring(0, tokens[2].length() - 1));

        // Checking last character to determine EAST or WEST direction
        this.direction =
            tokens[2].endsWith("E") ? "EAST" : "WEST";
    }

    // Converting timestamp String into numeric double value
    public double getTimestamp() {

        // Parsing string into float value
        return Float.parseFloat(timestamp);
    }

    // Getter method to return license plate
    public String getLicensePlate() {
        return licensePlate;
    }

    // Getter method to return booth type
    public String getBoothType() {
        return boothType;
    }

    // Getter method to return location
    public int getLocation() {
        return location;
    }

    // Getter method to return direction
    public String getDirection() {
        return direction;
    }

    // Overriding toString() method for readable object printing
    @Override
    public String toString() {

        // Returning formatted string representation of object
        return String.format(
            "<LogEntry timestamp: %f  license: %s  location: %d  direction: %s  booth: %s>",

            // Passing numeric timestamp because %f expects float/double
            getTimestamp(),

            // Passing remaining values
            licensePlate,
            location,
            direction,
            boothType
        );
    }
}


// LogFile class manages complete log list and analysis operations
class LogFile {

    // Creating list to store all LogEntry objects
    List<LogEntry> logEntries = new ArrayList<>();

    // Constructor to load all log lines into objects
    LogFile(String[] lines) {

        // Adding loop to iterate through all input log lines
        for (String line : lines)

            // Adding condition to ignore empty lines
            if (!line.trim().isEmpty())

                // Creating LogEntry object and adding into list
                logEntries.add(new LogEntry(line.trim()));
    }

    // Method to get entry at specific index
    LogEntry get(int i) {

        // Returning object from list
        return logEntries.get(i);
    }

    // Method to get total log count
    int size() {

        // Returning list size
        return logEntries.size();
    }

    // Method to count completed journeys
    public int countJourneys() {

        // Variable to store journey count
        int count = 0;

        // Looping through all log entries
        for (LogEntry e : logEntries)

            // Checking if booth type is EXIT
            if (e.getBoothType().equals("EXIT"))

                // Incrementing count because every EXIT means completed journey
                count++;

        // Returning total completed journeys
        return count;
    }

    // Method to detect speeding vehicles
    public List<String> catchSpeeders() {

        // Creating list to store ticketed vehicle numbers
        List<String> tickets = new ArrayList<>();

        // Map to store previous timestamp of each vehicle
        Map<String, Double> prevTime = new HashMap<>();

        // Map to store previous location of each vehicle
        Map<String, Integer> prevLocation = new HashMap<>();

        // Map to count how many times speed crossed 120
        Map<String, Integer> over120Count = new HashMap<>();

        // Map to track whether ticket already issued
        Map<String, Boolean> ticketed = new HashMap<>();

        // Looping through every log entry
        for (LogEntry e : logEntries) {

            // Extracting vehicle plate number
            String plate = e.getLicensePlate();

            // Extracting booth type
            String type = e.getBoothType();

            // Checking if current log is ENTRY
            if (type.equals("ENTRY")) {

                // Storing initial timestamp for journey start
                prevTime.put(plate, e.getTimestamp());

                // Storing initial location
                prevLocation.put(plate, e.getLocation());

                // Initializing over120 counter as 0
                over120Count.put(plate, 0);

                // Marking ticket status false initially
                ticketed.put(plate, false);
            }

            // Checking if vehicle already exists in tracking map
            else if (prevTime.containsKey(plate)) {

                // Calculating time difference between current and previous booth
                double timeDiff =
                    e.getTimestamp() - prevTime.get(plate);

                // Calculating distance difference
                int distDiff =
                    Math.abs(e.getLocation() - prevLocation.get(plate));

                // Applying speed formula
                double speed =
                    (distDiff * 3600.0) / timeDiff;

                // Checking if vehicle is not already ticketed
                if (!ticketed.get(plate)) {

                    // Rule 1: If speed >= 130 directly issue ticket
                    if (speed >= 130.0) {

                        // Updating ticket status
                        ticketed.put(plate, true);
                    }

                    // Rule 2: Checking if speed crossed 120
                    else if (speed >= 120.0) {

                        // Incrementing count of over120 occurrences
                        int cnt =
                            over120Count.get(plate) + 1;

                        // Updating map with new count
                        over120Count.put(plate, cnt);

                        // If crossed 120 two times then issue ticket
                        if (cnt >= 2)

                            // Updating ticket status
                            ticketed.put(plate, true);
                    }
                }

                // Updating latest timestamp
                prevTime.put(plate, e.getTimestamp());

                // Updating latest location
                prevLocation.put(plate, e.getLocation());

                // Checking if journey ended and vehicle was ticketed
                if (type.equals("EXIT") && ticketed.get(plate))

                    // Adding vehicle number into ticket list
                    tickets.add(plate);
            }
        }

        // Returning final ticket list
        return tickets;
    }
}


