class MembershipStatistics {

    // Variable to store total members
    public int totalMembers;

    // Variable to store total paid members
    public int totalPaidMembers;

    // Variable to store conversion percentage
    public double conversionRate;


    // Constructor to initialize statistics
    MembershipStatistics(int t, int p, double r) {

        // Assigning total members
        totalMembers = t;

        // Assigning paid members count
        totalPaidMembers = p;

        // Assigning conversion rate
        conversionRate = r;
    }
}



// Membership class manages all members and workouts
class Membership {

    // List to store all members
    public List<Member> members =
        new ArrayList<>();

    // Map to store workouts against member ID
    Map<Integer, List<Workout>> workoutsByMember =
        new HashMap<>();


    // Method to add member into list
    void addMember(Member m) {

        // Adding member into members list
        members.add(m);
    }



    // Method to update membership status
    void updateMembership(
        int memberId,
        MembershipStatus status
    ) {

        // Adding loop to iterate through all members
        for (Member m : members)

            // Checking if memberId matches
            if (m.memberId == memberId) {

                // Updating membership status
                m.membershipStatus = status;

                // Stopping loop after update
                break;
            }
    }



    // Method to calculate membership statistics
    MembershipStatistics getMembershipStatistics() {

        // Variable to count premium members
        int premium = 0;


        // Looping through all members
        for (Member m : members)

            // Checking if member is GOLD or SILVER
            if (m.membershipStatus == MembershipStatus.GOLD
             || m.membershipStatus == MembershipStatus.SILVER)

                // Incrementing premium count
                premium++;


        // Calculating conversion rate
        double rate =
            members.size() == 0
            ? 0.0
            : (premium / (double) members.size()) * 100.0;


        // Returning statistics object
        return new MembershipStatistics(
            members.size(),
            premium,
            rate
        );
    }



    // ── TASK 2.1: addWorkout() ───────────────────────

    // Method to add workout for a member
    public void addWorkout(
        Integer memId,
        Workout wk
    ) {

        // Looping through all members
        for (Member m : members) {

            // Checking if member exists
            if (m.memberId == memId) {

                // Adding workout into map
                workoutsByMember
                    .computeIfAbsent(
                        memId,
                        k -> new ArrayList<>()
                    )
                    .add(wk);

                // Stopping method after successful addition
                return;
            }
        }

        // If member not found then silently ignore
    }



    // ── TASK 2.2: getAverageWorkoutDurations() ───────────────────────

    // Method to calculate average workout duration
    public Map<Integer, Double>
    getAverageWorkoutDurations() {

        // Creating result map
        Map<Integer, Double> avgByMember =
            new HashMap<>();


        // Looping through map entries
        for (Map.Entry<Integer, List<Workout>> entry
                : workoutsByMember.entrySet()) {

            // Variable to store total duration
            double total = 0.0;


            // Looping through workouts of current member
            for (Workout w : entry.getValue())

                // Adding workout duration
                total += w.getDuration();


            // Calculating and storing average duration
            avgByMember.put(
                entry.getKey(),
                total / entry.getValue().size()
            );
        }

        // Returning final map
        return avgByMember;
    }



    // ── TASK 3: getPaymentDues() ───────────────────────

    // Method to calculate payment due for each member
    public Map<Integer, Double> getPaymentDues() {

        // Creating result map
        Map<Integer, Double> dueByMember =
            new HashMap<>();


        // Looping through all members
        for (Member member : members) {

            // Variables to store free workout limit and rate
            int freeLimit, rate;


            // Checking if membership is BRONZE
            if (member.membershipStatus
                    == MembershipStatus.BRONZE) {

                // Setting bronze rules
                freeLimit = 1;
                rate = 10;
            }

            // Checking if membership is SILVER
            else if (member.membershipStatus
                        == MembershipStatus.SILVER) {

                // Setting silver rules
                freeLimit = 3;
                rate = 8;
            }

            // Otherwise membership is GOLD
            else {

                // Setting gold rules
                freeLimit = 5;
                rate = 6;
            }


            // Fetching workouts for member
            List<Workout> workouts =
                workoutsByMember.getOrDefault(
                    member.memberId,
                    new ArrayList<>()
                );


            // Variable to store total due
            double totalDue = 0.0;


            // Loop starts after free workout limit
            for (int i = freeLimit;
                 i < workouts.size();
                 i++) {

                // Calculating hours using ceiling division
                int hours =
                    (workouts.get(i).getDuration() + 59)
                    / 60;

                // Adding charges into total due
                totalDue += hours * rate;
            }


            // Storing final due amount
            dueByMember.put(
                member.memberId,
                totalDue
            );
        }

        // Returning dues map
        return dueByMember;
    }
}



