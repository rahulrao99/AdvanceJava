    // Method to calculate account balance
    public double getBalance(int accountId) {

        // Variable to store final balance
        double balance = 0.0;

        
        // Adding for loop to iterate through all transactions
        for (Transaction tx : transactions) {

            
            // Adding if condition to check whether transaction belongs to requested account
            if (tx.accountId == accountId) {

                
                // Adding if condition to check if transaction is CREDIT
                if (tx.type == TransactionType.CREDIT)

                    // CREDIT means money added to balance
                    balance += tx.amount;

                else

                    // DEBIT means money deducted from balance
                    balance -= tx.amount;
            }
        }

        
        // Returning final calculated balance
        return balance;
    }


