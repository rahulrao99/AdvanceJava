// Importing Java utility package for List, Map, HashMap, ArrayList, Collections etc.
import java.util.*;


// Creating enum to define all possible order states
enum OrderStatus {

    // Order is newly placed by customer
    PLACED,

    // Restaurant is preparing food
    PREPARING,

    // Delivery partner is delivering order
    OUT_FOR_DELIVERY,

    // Order successfully delivered
    DELIVERED,

    // Order cancelled
    CANCELED
}


// Order class represents one food order
class Order {

    // Unique order ID
    int orderId;

    // Restaurant ID from where order was placed
    int restaurantId;

    // Customer ID who placed the order
    int customerId;

    // Total order amount
    double orderValue;

    // Distance travelled for delivery
    double distanceKm;

    // Current order status
    OrderStatus status;


    // Constructor to initialise all order fields
    Order(
            int orderId,
            int restaurantId,
            int customerId,
            double orderValue,
            double distanceKm,
            OrderStatus status
    ) {

        // Assigning constructor values to object variables
        this.orderId = orderId;

        this.restaurantId = restaurantId;

        this.customerId = customerId;

        this.orderValue = orderValue;

        this.distanceKm = distanceKm;

        this.status = status;
    }
}


// OrderStats class used as response object to return counts
class OrderStats {

    // Total order count
    int totalOrders;

    // Active order count
    int activeOrders;

    // Closed order count
    int closedOrders;


    // Constructor to initialise statistics
    OrderStats(int t, int a, int c) {

        // Storing total orders
        totalOrders = t;

        // Storing active orders
        activeOrders = a;

        // Storing closed orders
        closedOrders = c;
    }
}


// OrderManager class manages all orders
class OrderManager {

    // Creating list to store all orders
    List<Order> orders = new ArrayList<>();


    // Method to add order into list
    void addOrder(Order order) {

        // Adding order object into orders list
        orders.add(order);
    }


    // Method to update order status
    void updateOrderStatus(int orderId, OrderStatus newStatus) {

        // Adding for loop to iterate through all orders
        for (Order o : orders) {

            // Adding if condition to find matching order ID
            if (o.orderId == orderId) {

                // Updating order status
                o.status = newStatus;

                // Returning immediately after updating order
                return;
            }
        }
    }


    // Method to calculate total, active and closed order count
    OrderStats getOrderStatistics() {

        // Total orders = size of orders list
        int total = orders.size();

        // Variables to track active and closed orders
        int active = 0;
        int closed = 0;


        // Adding for loop to iterate through all orders
        for (Order o : orders) {


            // Adding if condition to check ACTIVE order states
            if (
                    o.status == OrderStatus.PLACED
                    || o.status == OrderStatus.PREPARING
                    || o.status == OrderStatus.OUT_FOR_DELIVERY
            ) {

                // Increasing active count
                active++;
            }

            else {

                // If not active then it is CLOSED
                // Covers DELIVERED and CANCELED
                closed++;
            }
        }


        // Returning statistics object
        return new OrderStats(total, active, closed);
    }


    // Method to calculate revenue generated by each restaurant
    Map<Integer, Double> getRevenuePerRestaurant() {

        // Creating map where:
        // key   = restaurantId
        // value = total revenue
        Map<Integer, Double> revenue = new HashMap<>();


        // Adding for loop to iterate through all orders
        for (Order o : orders) {


            // Adding if condition to consider only DELIVERED orders
            if (o.status == OrderStatus.DELIVERED) {


                // Adding order value into restaurant revenue
                revenue.put(

                        // Restaurant ID as key
                        o.restaurantId,

                        // Existing revenue + current order value
                        revenue.getOrDefault(
                                o.restaurantId,
                                0.0
                        ) + o.orderValue
                );
            }
        }


        // Returning revenue map
        return revenue;
    }


    // Method to calculate average delivery distance per customer
    Map<Integer, Double> getAverageDeliveryDistancePerCustomer() {


        // Map to store total distance travelled per customer
        Map<Integer, Double> sumMap = new HashMap<>();


        // Map to store delivery count per customer
        Map<Integer, Integer> countMap = new HashMap<>();


        // Adding for loop to iterate through all orders
        for (Order o : orders) {


            // Adding if condition to consider only DELIVERED orders
            if (o.status == OrderStatus.DELIVERED) {


                // Adding current distance into total distance
                sumMap.put(
                        o.customerId,

                        // Existing distance + current distance
                        sumMap.getOrDefault(
                                o.customerId,
                                0.0
                        ) + o.distanceKm
                );


                // Increasing delivery count for customer
                countMap.put(
                        o.customerId,

                        // Existing count + 1
                        countMap.getOrDefault(
                                o.customerId,
                                0
                        ) + 1
                );
            }
        }


        // Creating result map to store averages
        Map<Integer, Double> result = new HashMap<>();


        // Adding for loop to iterate through all customer IDs
        for (int id : sumMap.keySet()) {


            // Calculating average distance = total distance / delivery count
            result.put(
                    id,
                    sumMap.get(id) / countMap.get(id)
            );
        }


        // Returning average map
        return result;
    }


    // Method to find customers having 3 or more orders
    List<Integer> getHighlyActiveCustomers() {


        // Creating map to count orders per customer
        Map<Integer, Integer> countMap = new HashMap<>();


        // Adding for loop to iterate through all orders
        for (Order o : orders) {


            // Increasing order count of customer
            countMap.put(

                    // Customer ID as key
                    o.customerId,

                    // Existing count + 1
                    countMap.getOrDefault(
                            o.customerId,
                            0
                    ) + 1
            );
        }


        // Creating list to store highly active customers
        List<Integer> result = new ArrayList<>();


        // Adding for loop to iterate through map entries
        for (Map.Entry<Integer, Integer> entry
                : countMap.entrySet()) {


            // Adding if condition to check customer has 3 or more orders
            if (entry.getValue() >= 3) {

                // Adding customer ID into result list
                result.add(entry.getKey());
            }
        }


        // Sorting result list in ascending order
        Collections.sort(result);


        // Returning sorted customer list
        return result;
    }
}



