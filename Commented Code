    // Method to calculate transaction fees for each account
    public Map<Integer, Double> getTransactionFees() {


        
        // STEP 1 : Group transactions account-wise
        
        // Creating map where:
        // key   = accountId
        // value = list of transactions of that account
        Map<Integer, List<Transaction>> txByAccount = new HashMap<>();


        
        // Adding for loop to iterate through all transactions
        for (Transaction tx : transactions) {

            
            // computeIfAbsent creates new ArrayList if account key not present
            // then adds transaction into that account list
            txByAccount
                    .computeIfAbsent(
                            tx.getAccountId(),
                            k -> new ArrayList<>()
                    )
                    .add(tx);
        }


        
        // Creating final fees map
        Map<Integer, Double> fees = new HashMap<>();


        
        // Adding for loop to iterate through each account entry
        for (Map.Entry<Integer, List<Transaction>> entry
                : txByAccount.entrySet()) {

            
            // Getting all transactions of current account
            List<Transaction> accountTxs = entry.getValue();


            
            // STEP 2 : Sorting transactions by timestamp
            
            // Sorting because input transactions may come in random order
            accountTxs.sort(
                    Comparator.comparingLong(
                            Transaction::getTimestampSec
                    )
            );


            
            // Variable to store total fee of current account
            double totalFee = 0.0;


            
            // STEP 3 : Applying fee rules
            
            // Adding for loop using index because fee depends on transaction position
            for (int i = 0; i < accountTxs.size(); i++) {


                
                // Adding if condition to skip first 3 free transactions
                if (i >= 3) {

                    
                    // Fetching current transaction
                    Transaction tx = accountTxs.get(i);


                    
                    // Adding ternary operator to apply fee rule:
                    // CREDIT = $1
                    // DEBIT  = $2
                    totalFee +=
                            (tx.getType() == TransactionType.CREDIT)
                                    ? 1.0
                                    : 2.0;
                }
            }


            
            // Storing final fee of current account into map
            fees.put(entry.getKey(), totalFee);
        }


        
        // Returning final fees map
        return fees;
    }
