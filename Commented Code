// Stock class represents one company stock using symbol and name
class Stock {

    // Variable to store stock symbol like AAPL
    String symbol;

    // Variable to store company name
    String name;

    // Constructor to initialize stock details
    Stock(String sym, String name) {

        // Assigning symbol value
        this.symbol = sym;

        // Assigning company name value
        this.name = name;
    }

    // Overriding equals method to compare Stock objects logically
    @Override
    public boolean equals(Object o) {

        // Checking if object is not instance of Stock
        if (!(o instanceof Stock))

            // Returning false because object type is different
            return false;

        // Typecasting Object into Stock object
        Stock s = (Stock) o;

        // Comparing both symbol and name values
        return symbol.equals(s.symbol) && name.equals(s.name);
    }

    // Overriding hashCode because equals is overridden
    @Override
    public int hashCode() {

        // Generating hash using symbol and name
        return Objects.hash(symbol, name);
    }
}


// PriceRecord class stores one stock price entry
class PriceRecord {

    // Storing Stock object
    Stock stock;

    // Storing stock price
    int price;

    // Storing date in YYYY-MM-DD format
    String date;

    // Constructor to initialize all fields
    PriceRecord(Stock s, int p, String d) {

        // Assigning stock object
        stock = s;

        // Assigning stock price
        price = p;

        // Assigning date
        date = d;
    }
}


// StockCollection class manages all records for one stock
class StockCollection {

    // Creating list to store all price records
    List<PriceRecord> priceRecords = new ArrayList<>();

    // Variable to store which stock this collection belongs to
    Stock stock;

    // Constructor to initialize stock collection
    StockCollection(Stock s) {

        // Assigning stock
        stock = s;
    }

    // Method to add one price record
    void addPriceRecord(PriceRecord pr) {

        // Adding condition to validate stock consistency
        if (!pr.stock.equals(stock))

            // Throwing exception if stock mismatches
            throw new IllegalArgumentException("Stock mismatch");

        // Adding valid record into list
        priceRecords.add(pr);
    }

    // Method to get total number of records
    int getNumPriceRecords() {

        // Returning size of list
        return priceRecords.size();
    }


    // ── TASK 1: getMaxPrice() ───────────────────────────

    // Method to return maximum stock price
    int getMaxPrice() {

        // Checking if list is empty to avoid crash
        if (priceRecords.isEmpty())

            // Returning -1 as sentinel value
            return -1;

        // Using stream to extract price values and find maximum
        return priceRecords
                .stream()
                .mapToInt(r -> r.price)
                .max()
                .getAsInt();
    }


    // ── TASK 1: getMinPrice() ───────────────────────────

    // Method to return minimum stock price
    int getMinPrice() {

        // Checking if list is empty
        if (priceRecords.isEmpty())

            // Returning -1 when no records available
            return -1;

        // Using stream to extract prices and find minimum
        return priceRecords
                .stream()
                .mapToInt(r -> r.price)
                .min()
                .getAsInt();
    }


    // ── TASK 1: getAvgPrice() ───────────────────────────

    // Method to calculate average stock price
    double getAvgPrice() {

        // Checking if list is empty to avoid division by zero
        if (priceRecords.isEmpty())

            // Returning -1.0 when no data available
            return -1.0;

        // Calculating total sum of prices using stream
        double total =
            priceRecords.stream()
                        .mapToInt(r -> r.price)
                        .sum();

        // Returning average
        return total / priceRecords.size();
    }


    // ── TASK 2: getBiggestChange() ───────────────────────────

    // Method to find biggest price change between consecutive dates
    Object[] getBiggestChange() {

        // Checking if records are less than 2 because comparison needs at least 2 entries
        if (priceRecords.size() < 2)

            // Returning null because comparison not possible
            return null;

        // Creating new list copy so original list remains unchanged
        List<PriceRecord> sorted =
            new ArrayList<>(priceRecords);

        // Sorting records based on date string
        sorted.sort((r1, r2) ->
            r1.date.compareTo(r2.date));

        // Initializing biggest change using first two records
        int biggestChange =
            sorted.get(1).price - sorted.get(0).price;

        // Storing earlier date
        String earlierDate =
            sorted.get(0).date;

        // Storing later date
        String laterDate =
            sorted.get(1).date;

        // Adding loop to iterate through consecutive pairs
        for (int i = 1; i < sorted.size() - 1; i++) {

            // Calculating price difference between consecutive records
            int change =
                sorted.get(i + 1).price -
                sorted.get(i).price;

            // Comparing absolute values because biggest magnitude is required
            if (Math.abs(change) > Math.abs(biggestChange)) {

                // Updating biggest change value
                biggestChange = change;

                // Updating earlier date
                earlierDate = sorted.get(i).date;

                // Updating later date
                laterDate = sorted.get(i + 1).date;
            }
        }

        // Returning result as Object array
        return new Object[]{
            biggestChange,
            earlierDate,
            laterDate
        };
    }
}



