                            "Management Service")
                        .version("1.0.0")
                        .contact(new Contact()
                                .name("Leave Management")
                                .email("admin@leave.com")))
                .addSecurityItem(
                        new SecurityRequirement()
                                .addList("Bearer Auth"))
                .components(new Components()
                        .addSecuritySchemes(
                                "Bearer Auth",
                                new SecurityScheme()
                                        .type(SecurityScheme
