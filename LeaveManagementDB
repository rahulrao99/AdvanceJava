-- ============================================
-- EMPLOYEE LEAVE MANAGEMENT SYSTEM
-- Complete MySQL Schema DDL
-- AUTO_INCREMENT IDs (no UUID)
-- Version: 2.0
-- ============================================

-- Create Database
CREATE DATABASE IF NOT EXISTS leave_management_db
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE leave_management_db;

-- ============================================
-- TABLE 1: users
-- Managed by: User Service (port 8081)
-- ============================================
CREATE TABLE IF NOT EXISTS users (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    username        VARCHAR(50)     NOT NULL,
    email           VARCHAR(150)    NOT NULL,
    password_hash   VARCHAR(255)    NOT NULL,
    phone           VARCHAR(15),
    role            ENUM(
                        'ROLE_EMPLOYEE',
                        'ROLE_MANAGER',
                        'ROLE_HR',
                        'ROLE_ADMIN'
                    )               NOT NULL DEFAULT 'ROLE_EMPLOYEE',
    is_active       TINYINT(1)      NOT NULL DEFAULT 1,
    last_login      DATETIME,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_users_email    (email),
    UNIQUE KEY uq_users_username (username),
    INDEX idx_users_role         (role),
    INDEX idx_users_is_active    (is_active)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 2: departments
-- Managed by: Employee Service (port 8082)
-- ============================================
CREATE TABLE IF NOT EXISTS departments (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    name            VARCHAR(100)    NOT NULL,
    description     TEXT,
    manager_id      BIGINT,
    is_active       TINYINT(1)      NOT NULL DEFAULT 1,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_departments_name (name),
    INDEX idx_departments_manager  (manager_id),
    INDEX idx_departments_active   (is_active)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 3: employees
-- Managed by: Employee Service (port 8082)
-- ============================================
CREATE TABLE IF NOT EXISTS employees (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    user_id         BIGINT          NOT NULL,
    employee_code   VARCHAR(20)     NOT NULL,
    first_name      VARCHAR(50)     NOT NULL,
    last_name       VARCHAR(50)     NOT NULL,
    email           VARCHAR(150)    NOT NULL,
    phone           VARCHAR(15),
    department_id   BIGINT,
    manager_id      BIGINT,
    designation     VARCHAR(100)    NOT NULL,
    employment_type ENUM(
                        'FULL_TIME',
                        'PART_TIME',
                        'CONTRACT',
                        'INTERN'
                    )               NOT NULL DEFAULT 'FULL_TIME',
    joining_date    DATE            NOT NULL,
    leaving_date    DATE,
    is_active       TINYINT(1)      NOT NULL DEFAULT 1,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_employees_user_id  (user_id),
    UNIQUE KEY uq_employees_code     (employee_code),
    UNIQUE KEY uq_employees_email    (email),
    INDEX idx_employees_department   (department_id),
    INDEX idx_employees_manager      (manager_id),
    INDEX idx_employees_active       (is_active),
    INDEX idx_employees_emp_type     (employment_type),
    CONSTRAINT fk_employees_user
        FOREIGN KEY (user_id)
            REFERENCES users(id),
    CONSTRAINT fk_employees_department
        FOREIGN KEY (department_id)
            REFERENCES departments(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 4: leave_types
-- Managed by: Leave Service (port 8083)
-- ============================================
CREATE TABLE IF NOT EXISTS leave_types (
    id                  BIGINT          NOT NULL AUTO_INCREMENT,
    name                VARCHAR(100)    NOT NULL,
    code                VARCHAR(20)     NOT NULL,
    description         TEXT,
    max_days_per_year   INT             NOT NULL DEFAULT 0,
    max_days_per_apply  INT             NOT NULL DEFAULT 0,
    min_days_per_apply  DECIMAL(3,1)    NOT NULL DEFAULT 0.5,
    is_paid             TINYINT(1)      NOT NULL DEFAULT 1,
    carry_forward       TINYINT(1)      NOT NULL DEFAULT 0,
    carry_forward_limit INT             NOT NULL DEFAULT 0,
    requires_approval   TINYINT(1)      NOT NULL DEFAULT 1,
    auto_approve_after  INT             NOT NULL DEFAULT 0,
    applicable_gender   ENUM(
                            'ALL',
                            'MALE',
                            'FEMALE'
                        )               NOT NULL DEFAULT 'ALL',
    is_active           TINYINT(1)      NOT NULL DEFAULT 1,
    created_at          DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at          DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                        ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_leave_types_name  (name),
    UNIQUE KEY uq_leave_types_code  (code),
    INDEX idx_leave_types_active    (is_active),
    INDEX idx_leave_types_gender    (applicable_gender)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 5: employee_leave_balance
-- Managed by: Employee Service (port 8082)
-- ============================================
CREATE TABLE IF NOT EXISTS employee_leave_balance (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    employee_id     BIGINT          NOT NULL,
    leave_type_id   BIGINT          NOT NULL,
    year            INT             NOT NULL,
    total_days      DECIMAL(5,1)    NOT NULL DEFAULT 0,
    used_days       DECIMAL(5,1)    NOT NULL DEFAULT 0,
    pending_days    DECIMAL(5,1)    NOT NULL DEFAULT 0,
    remaining_days  DECIMAL(5,1)    NOT NULL DEFAULT 0,
    carried_forward DECIMAL(5,1)    NOT NULL DEFAULT 0,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_balance_emp_type_year
        (employee_id, leave_type_id, year),
    INDEX idx_balance_employee      (employee_id),
    INDEX idx_balance_leave_type    (leave_type_id),
    INDEX idx_balance_year          (year),
    CONSTRAINT fk_balance_employee
        FOREIGN KEY (employee_id)
            REFERENCES employees(id),
    CONSTRAINT fk_balance_leave_type
        FOREIGN KEY (leave_type_id)
            REFERENCES leave_types(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 6: leave_applications
-- Managed by: Leave Service (port 8083)
-- ============================================
CREATE TABLE IF NOT EXISTS leave_applications (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    employee_id     BIGINT          NOT NULL,
    leave_type_id   BIGINT          NOT NULL,
    start_date      DATE            NOT NULL,
    end_date        DATE            NOT NULL,
    total_days      DECIMAL(5,1)    NOT NULL,
    is_half_day     TINYINT(1)      NOT NULL DEFAULT 0,
    half_day_type   ENUM(
                        'FIRST_HALF',
                        'SECOND_HALF'
                    ),
    reason          TEXT            NOT NULL,
    status          ENUM(
                        'PENDING',
                        'APPROVED',
                        'REJECTED',
                        'CANCELLED',
                        'AUTO_APPROVED'
                    )               NOT NULL DEFAULT 'PENDING',
    applied_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    reviewed_at     DATETIME,
    cancelled_at    DATETIME,
    cancel_reason   TEXT,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    INDEX idx_leave_app_employee    (employee_id),
    INDEX idx_leave_app_leave_type  (leave_type_id),
    INDEX idx_leave_app_status      (status),
    INDEX idx_leave_app_dates       (start_date, end_date),
    INDEX idx_leave_app_applied_at  (applied_at),
    CONSTRAINT fk_leave_app_employee
        FOREIGN KEY (employee_id)
            REFERENCES employees(id),
    CONSTRAINT fk_leave_app_leave_type
        FOREIGN KEY (leave_type_id)
            REFERENCES leave_types(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 7: leave_approvals
-- Managed by: Leave Service (port 8083)
-- ============================================
CREATE TABLE IF NOT EXISTS leave_approvals (
    id                  BIGINT          NOT NULL AUTO_INCREMENT,
    application_id      BIGINT          NOT NULL,
    approver_id         BIGINT          NOT NULL,
    approver_role       ENUM(
                            'ROLE_MANAGER',
                            'ROLE_HR',
                            'ROLE_ADMIN'
                        )               NOT NULL,
    action              ENUM(
                            'APPROVED',
                            'REJECTED',
                            'FORWARDED'
                        )               NOT NULL,
    comments            TEXT,
    action_at           DATETIME        NOT NULL
                                        DEFAULT CURRENT_TIMESTAMP,
    created_at          DATETIME        NOT NULL
                                        DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    INDEX idx_approvals_application (application_id),
    INDEX idx_approvals_approver    (approver_id),
    INDEX idx_approvals_action      (action),
    INDEX idx_approvals_action_at   (action_at),
    CONSTRAINT fk_approvals_application
        FOREIGN KEY (application_id)
            REFERENCES leave_applications(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 8: holidays
-- Managed by: Leave Service (port 8083)
-- ============================================
CREATE TABLE IF NOT EXISTS holidays (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    name            VARCHAR(100)    NOT NULL,
    holiday_date    DATE            NOT NULL,
    holiday_type    ENUM(
                        'NATIONAL',
                        'OPTIONAL',
                        'RESTRICTED'
                    )               NOT NULL DEFAULT 'NATIONAL',
    description     TEXT,
    is_active       TINYINT(1)      NOT NULL DEFAULT 1,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_holidays_date_name (holiday_date, name),
    INDEX idx_holidays_date          (holiday_date),
    INDEX idx_holidays_type          (holiday_type),
    INDEX idx_holidays_active        (is_active)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 9: notifications
-- Managed by: Notification Service (port 8084)
-- ============================================
CREATE TABLE IF NOT EXISTS notifications (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    user_id         BIGINT          NOT NULL,
    type            VARCHAR(50)     NOT NULL,
    channel         ENUM(
                        'EMAIL',
                        'SMS',
                        'PUSH',
                        'IN_APP'
                    )               NOT NULL DEFAULT 'EMAIL',
    subject         VARCHAR(255),
    body            TEXT,
    status          ENUM(
                        'PENDING',
                        'SENT',
                        'FAILED',
                        'SKIPPED'
                    )               NOT NULL DEFAULT 'PENDING',
    retry_count     INT             NOT NULL DEFAULT 0,
    sent_at         DATETIME,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    INDEX idx_notifications_user    (user_id),
    INDEX idx_notifications_status  (status),
    INDEX idx_notifications_type    (type),
    INDEX idx_notifications_created (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 10: audit_logs
-- Managed by: Audit Service (port 8086)
-- ============================================
CREATE TABLE IF NOT EXISTS audit_logs (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    user_id         BIGINT          NOT NULL,
    action          VARCHAR(100)    NOT NULL,
    entity          VARCHAR(100)    NOT NULL,
    entity_id       BIGINT,
    old_value       JSON,
    new_value       JSON,
    ip_address      VARCHAR(45),
    description     TEXT,
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    INDEX idx_audit_user        (user_id),
    INDEX idx_audit_action      (action),
    INDEX idx_audit_entity      (entity),
    INDEX idx_audit_entity_id   (entity_id),
    INDEX idx_audit_created     (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 11: leave_reports
-- Managed by: Report Service (port 8085)
-- ============================================
CREATE TABLE IF NOT EXISTS leave_reports (
    id              BIGINT          NOT NULL AUTO_INCREMENT,
    generated_by    BIGINT          NOT NULL,
    report_type     ENUM(
                        'MONTHLY',
                        'YEARLY',
                        'DEPARTMENT',
                        'EMPLOYEE',
                        'LEAVE_TYPE',
                        'CUSTOM'
                    )               NOT NULL,
    title           VARCHAR(255)    NOT NULL,
    from_date       DATE,
    to_date         DATE,
    department_id   BIGINT,
    employee_id     BIGINT,
    report_data     JSON,
    status          ENUM(
                        'GENERATING',
                        'COMPLETED',
                        'FAILED'
                    )               NOT NULL DEFAULT 'GENERATING',
    created_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP
                                    ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    INDEX idx_reports_generated_by  (generated_by),
    INDEX idx_reports_type          (report_type),
    INDEX idx_reports_dates         (from_date, to_date),
    INDEX idx_reports_department    (department_id),
    INDEX idx_reports_employee      (employee_id),
    INDEX idx_reports_created       (created_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- TABLE 12: leave_calendar
-- Managed by: Leave Service (port 8083)
-- ============================================
CREATE TABLE IF NOT EXISTS leave_calendar (
    id                  BIGINT          NOT NULL AUTO_INCREMENT,
    employee_id         BIGINT          NOT NULL,
    application_id      BIGINT          NOT NULL,
    leave_date          DATE            NOT NULL,
    leave_type_id       BIGINT          NOT NULL,
    is_half_day         TINYINT(1)      NOT NULL DEFAULT 0,
    status              ENUM(
                            'PENDING',
                            'APPROVED',
                            'REJECTED',
                            'CANCELLED'
                        )               NOT NULL DEFAULT 'PENDING',
    created_at          DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_calendar_emp_date  (employee_id, leave_date),
    INDEX idx_calendar_employee      (employee_id),
    INDEX idx_calendar_date          (leave_date),
    INDEX idx_calendar_application   (application_id),
    INDEX idx_calendar_leave_type    (leave_type_id),
    INDEX idx_calendar_status        (status),
    CONSTRAINT fk_calendar_employee
        FOREIGN KEY (employee_id)
            REFERENCES employees(id),
    CONSTRAINT fk_calendar_application
        FOREIGN KEY (application_id)
            REFERENCES leave_applications(id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

