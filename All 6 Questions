// Enum: defines every possible state an order can be in
enum OrderStatus {
    PLACED,            // customer just placed the order  → ACTIVE
    PREPARING,         // restaurant is cooking           → ACTIVE
    OUT_FOR_DELIVERY,  // delivery agent picked it up     → ACTIVE
    DELIVERED,         // customer received it            → CLOSED
    CANCELED           // order was canceled              → CLOSED
}

// Order: holds all information about one single order (like a DB row)
class Order {
    int orderId;        // unique ID for this order
    int restaurantId;   // which restaurant made it
    int customerId;     // which customer placed it
    double orderValue;  // money value of this order
    double distanceKm;  // delivery distance in km
    OrderStatus status; // current state of the order

    // Constructor: stores all 6 values when we write "new Order(...)"
    Order(int orderId, int restaurantId, int customerId,
          double orderValue, double distanceKm, OrderStatus status) {
        this.orderId      = orderId;
        this.restaurantId = restaurantId;
        this.customerId   = customerId;
        this.orderValue   = orderValue;
        this.distanceKm   = distanceKm;
        this.status       = status;
    }
}

// OrderStats: container to return 3 counts from Task 1 in one object
class OrderStats {
    int totalOrders, activeOrders, closedOrders;
    OrderStats(int t, int a, int c) {
        totalOrders = t; activeOrders = a; closedOrders = c;
    }
}

// OrderManager: stores all orders and provides 4 query methods
class OrderManager {
    List<Order> orders = new ArrayList<>();

    void addOrder(Order order) { orders.add(order); }

    void updateOrderStatus(int orderId, OrderStatus newStatus) {
        for (Order o : orders) {
            if (o.orderId == orderId) { o.status = newStatus; return; }
        }
    }

    // ── TASK 1 (Bug Fix): getOrderStatistics() ────────────────────
    // BUG: no else block → closed always stayed 0
    // FIX: else block added → anything not active = closed
    OrderStats getOrderStatistics() {
        int total = orders.size(); // total = count all orders
        int active = 0, closed = 0;

        for (Order o : orders) {
            // Use == for enum comparison (not .equals())
            if (o.status == OrderStatus.PLACED
             || o.status == OrderStatus.PREPARING
             || o.status == OrderStatus.OUT_FOR_DELIVERY) {
                active++;
            } else {
                closed++; // FIX: catches DELIVERED + CANCELED
            }
        }
        return new OrderStats(total, active, closed);
    }

    // ── TASK 2: getRevenuePerRestaurant() ─────────────────────────
    // Only DELIVERED orders count. Uses getOrDefault to safely accumulate.
    // getOrDefault(key, 0.0): returns existing value OR 0.0 if key not seen yet
    Map<Integer, Double> getRevenuePerRestaurant() {
        Map<Integer, Double> revenue = new HashMap<>();
        for (Order o : orders) {
            if (o.status == OrderStatus.DELIVERED) { // only DELIVERED orders count
                revenue.put(o.restaurantId,
                    revenue.getOrDefault(o.restaurantId, 0.0) + o.orderValue);
            }
        }
        return revenue; // e.g. {10: 80.0, 11: 40.0}
    }

    // ── TASK 3: getAverageDeliveryDistancePerCustomer() ───────────
    // Two maps (sum + count) → divide at end to get average
    // Customers with no DELIVERED orders never enter sumMap → not in result
    Map<Integer, Double> getAverageDeliveryDistancePerCustomer() {
        Map<Integer, Double>  sumMap   = new HashMap<>(); // total km per customer
        Map<Integer, Integer> countMap = new HashMap<>(); // count of deliveries per customer

        for (Order o : orders) {
            if (o.status == OrderStatus.DELIVERED) { // only DELIVERED
                sumMap.put(o.customerId,
                    sumMap.getOrDefault(o.customerId, 0.0) + o.distanceKm);
                countMap.put(o.customerId,
                    countMap.getOrDefault(o.customerId, 0) + 1);
            }
        }

        Map<Integer, Double> result = new HashMap<>();
        for (int id : sumMap.keySet()) {
            result.put(id, sumMap.get(id) / countMap.get(id)); // avg = sum / count
        }
        return result;
    }

    // ── TASK 4: getHighlyActiveCustomers() ────────────────────────
    // Count ALL orders per customer (no status filter), filter >= 3, sort
    List<Integer> getHighlyActiveCustomers() {
        Map<Integer, Integer> countMap = new HashMap<>();
        for (Order o : orders) { // ALL statuses count — no filter
            countMap.put(o.customerId,
                countMap.getOrDefault(o.customerId, 0) + 1);
        }

        List<Integer> result = new ArrayList<>();
        for (Map.Entry<Integer, Integer> entry : countMap.entrySet()) {
            if (entry.getValue() >= 3) result.add(entry.getKey()); // threshold = 3
        }
        Collections.sort(result); // sort ascending
        return result;
    }
}

