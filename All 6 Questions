  PROBLEM STATEMENT
  BRONZE: 1st workout free, then $10/hr
  SILVER: first 3 free, then $8/hr
  GOLD:   first 5 free, then $6/hr
  Duration rounds UP to nearest hour: (duration + 59) / 60

  TASK 1 (Bug Fix): Member.equals() missing
    BUG: Java's default equals() compares memory addresses.
         Two "new Member(1,...)" objects are NEVER equal by default.
    FIX: Override equals() to compare by memberId.

  TASK 2.1: addWorkout(memberId, workout)
    If member doesn't exist → silently ignore.

  TASK 2.2: getAverageWorkoutDurations()
    Return {memberId → average duration in minutes}.

  TASK 3: getPaymentDues()
    Return {memberId → total amount owed}.
 └─────────────────────────────────────────────────────────────────┘
*/

// ══════════════════════════════════════════════════════════════════
//  SUPPORTING CLASSES
// ══════════════════════════════════════════════════════════════════

enum MembershipStatus { BRONZE, SILVER, GOLD }

// Workout: one gym session — times in minutes from midnight
class Workout {
    private int id, startTime, endTime;
    Workout(int id, int start, int end) { this.id=id; startTime=start; endTime=end; }
    public int getId()        { return id; }
    public int getStartTime() { return startTime; }
    public int getEndTime()   { return endTime; }
    // getDuration: how long the session lasted in minutes
    public int getDuration()  { return endTime - startTime; }
}

// Member: one gym member with ID, name, and membership tier
class Member {
    public int memberId;
    public String name;
    public MembershipStatus membershipStatus;

    Member(int id, String name, MembershipStatus status) {
        this.memberId = id; this.name = name; this.membershipStatus = status;
    }

    // ── TASK 1 (Bug Fix): override equals() ───────────────────────
    // BUG: Java's default equals() compares memory addresses (references)
    //      Two different "new Member(1,...)" objects → always NOT equal
    // FIX: compare by memberId (the unique identifier for each member)
    @Override
    public boolean equals(Object o) {
        if (this == o) return true;               // same object → equal
        if (!(o instanceof Member)) return false; // not a Member → not equal
        Member m = (Member) o;
        return this.memberId == m.memberId;        // FIX: compare by ID
    }

    // Always override hashCode with equals — keeps HashMap/HashSet working
    @Override
    public int hashCode() { return Integer.hashCode(memberId); }

    @Override
    public String toString() {
        return "Member ID: " + memberId + ", Name: " + name + ", Status: " + membershipStatus;
    }
}

class MembershipStatistics {
    public int totalMembers, totalPaidMembers;
    public double conversionRate;
    MembershipStatistics(int t, int p, double r) {
        totalMembers=t; totalPaidMembers=p; conversionRate=r;
    }
}

// Membership: manages all members and their workouts
class Membership {
    public List<Member> members = new ArrayList<>();
    Map<Integer, List<Workout>> workoutsByMember = new HashMap<>();

    void addMember(Member m) { members.add(m); }

    void updateMembership(int memberId, MembershipStatus status) {
        for (Member m : members)
            if (m.memberId == memberId) { m.membershipStatus = status; break; }
    }

    MembershipStatistics getMembershipStatistics() {
        int premium = 0;
        for (Member m : members)
            if (m.membershipStatus == MembershipStatus.GOLD
             || m.membershipStatus == MembershipStatus.SILVER) premium++;
        double rate = members.size() == 0 ? 0.0
                    : (premium / (double) members.size()) * 100.0;
        return new MembershipStatistics(members.size(), premium, rate);
    }

    // ── TASK 2.1: addWorkout() ────────────────────────────────────
    // If member exists → add workout. If not → silently ignore.
    // computeIfAbsent: creates new list if key absent, returns existing list if present
    public void addWorkout(Integer memId, Workout wk) {
        for (Member m : members) {
            if (m.memberId == memId) {
                workoutsByMember.computeIfAbsent(memId, k -> new ArrayList<>()).add(wk);
                return; // found and added → stop
            }
        }
        // member not found → do nothing (silently ignore)
    }

    // ── TASK 2.2: getAverageWorkoutDurations() ────────────────────
    // entrySet() gives each key-value pair. sum/count → average.
    public Map<Integer, Double> getAverageWorkoutDurations() {
        Map<Integer, Double> avgByMember = new HashMap<>();
        for (Map.Entry<Integer, List<Workout>> entry : workoutsByMember.entrySet()) {
            double total = 0.0;
            for (Workout w : entry.getValue()) total += w.getDuration();
            avgByMember.put(entry.getKey(), total / entry.getValue().size());
        }
        return avgByMember;
    }

    // ── TASK 3: getPaymentDues() ──────────────────────────────────
    // CEILING DIVISION: (duration + 59) / 60  → rounds up to nearest hour
    //   80min: (80+59)/60=2  ✓  60min: (60+59)/60=1  ✓  61min: (61+59)/60=2  ✓
    public Map<Integer, Double> getPaymentDues() {
        Map<Integer, Double> dueByMember = new HashMap<>();
        for (Member member : members) {
            int freeLimit, rate;
            if (member.membershipStatus == MembershipStatus.BRONZE)      { freeLimit=1; rate=10; }
            else if (member.membershipStatus == MembershipStatus.SILVER) { freeLimit=3; rate=8;  }
            else                                                          { freeLimit=5; rate=6;  }

            List<Workout> workouts = workoutsByMember.getOrDefault(member.memberId, new ArrayList<>());
            double totalDue = 0.0;
            // Start at index=freeLimit to skip the free workouts
            for (int i = freeLimit; i < workouts.size(); i++) {
                int hours = (workouts.get(i).getDuration() + 59) / 60; // ceiling division
                totalDue += hours * rate;
            }
            dueByMember.put(member.memberId, totalDue);
        }
        return dueByMember;
    }
}

