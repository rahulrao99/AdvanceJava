   timestamp(sec)   plate   loc+dir   boothType

  TASK 1 (Bug Fix): LogEntry.toString()
    BUG: passes "timestamp" (String) to %f (expects double/float)
         → MissingFormatArgumentException at runtime.
    FIX: call getTimestamp() which returns a double.

  TASK 2: countJourneys()
    Count complete journeys. Every journey ends at EXIT → count EXIT entries.

  TASK 3: catchSpeeders()
    Speed = (distance_km × 3600) / time_seconds
    Rule 1: Any segment ≥ 130 km/h → ticket
    Rule 2: Two segments ≥ 120 km/h in same journey → ticket
 └─────────────────────────────────────────────────────────────────┘
*/

// ══════════════════════════════════════════════════════════════════
//  SUPPORTING CLASSES
// ══════════════════════════════════════════════════════════════════

// LogEntry: parses and stores one toll booth log line
class LogEntry {
    private final String timestamp;    // stored as String e.g. "34400.409"
    private final String licensePlate;
    private final String boothType;    // "ENTRY", "EXIT", or "MAINROAD"
    private final int location;        // km from highway start
    private final String direction;    // "EAST" or "WEST"

    // Constructor: splits "44776.619 KTB918 310E MAINROAD" on spaces
    LogEntry(String logLine) {
        String[] tokens = logLine.split(" ");
        this.timestamp    = tokens[0];
        this.licensePlate = tokens[1];
        this.boothType    = tokens[3];
        this.location = Integer.parseInt(tokens[2].substring(0, tokens[2].length()-1));
        this.direction = tokens[2].endsWith("E") ? "EAST" : "WEST";
    }

    // getTimestamp: parses String "34400.409" → double 34400.409
    // This is what %f in toString() needs — a numeric type not a String
    public double getTimestamp()    { return Float.parseFloat(timestamp); }
    public String getLicensePlate() { return licensePlate; }
    public String getBoothType()    { return boothType; }
    public int getLocation()        { return location; }
    public String getDirection()    { return direction; }

    // ── TASK 1 (Bug Fix): toString() ──────────────────────────────
    // BUG: String.format("...%f...", timestamp,...) — "timestamp" is a String!
    //      %f expects double/float → MissingFormatArgumentException crash!
    // FIX: use getTimestamp() which returns double — %f handles it correctly
    @Override
    public String toString() {
        return String.format(
            "<LogEntry timestamp: %f  license: %s  location: %d  direction: %s  booth: %s>",
            getTimestamp(),  // FIX: was "timestamp" (String) → now getTimestamp() (double)
            licensePlate, location, direction, boothType
        );
    }
}

// LogFile: manages a list of LogEntry objects and provides analysis
class LogFile {
    List<LogEntry> logEntries = new ArrayList<>();

    // Constructor: takes array of log line strings (no file I/O needed)
    LogFile(String[] lines) {
        for (String line : lines)
            if (!line.trim().isEmpty()) logEntries.add(new LogEntry(line.trim()));
    }

    LogEntry get(int i) { return logEntries.get(i); }
    int size()          { return logEntries.size(); }

    // ── TASK 2: countJourneys() ───────────────────────────────────
    // Every complete journey ends at EXIT → count EXIT booth entries
    public int countJourneys() {
        int count = 0;
        for (LogEntry e : logEntries)
            if (e.getBoothType().equals("EXIT")) count++;
        return count;
    }

    // ── TASK 3: catchSpeeders() ───────────────────────────────────
    // Speed formula: (distance_km × 3600) / time_seconds = km/h
    // Track per plate: timestamp, location, over-120 count, ticketed flag
    // Reset at ENTRY (new journey). Add ticket at EXIT if speeding.
    public List<String> catchSpeeders() {
        List<String> tickets = new ArrayList<>();
        Map<String, Double>  prevTime     = new HashMap<>();
        Map<String, Integer> prevLocation = new HashMap<>();
        Map<String, Integer> over120Count = new HashMap<>();
        Map<String, Boolean> ticketed     = new HashMap<>();

        for (LogEntry e : logEntries) {
            String plate = e.getLicensePlate();
            String type  = e.getBoothType();

            if (type.equals("ENTRY")) {
                // Start fresh tracking for this new journey
                prevTime.put(plate, e.getTimestamp());
                prevLocation.put(plate, e.getLocation());
                over120Count.put(plate, 0);
                ticketed.put(plate, false);

            } else if (prevTime.containsKey(plate)) {
                // On highway (MAINROAD or EXIT) → calculate segment speed
                double timeDiff = e.getTimestamp() - prevTime.get(plate);
                int distDiff    = Math.abs(e.getLocation() - prevLocation.get(plate));
                double speed    = (distDiff * 3600.0) / timeDiff; // km/h

                if (!ticketed.get(plate)) {
                    if (speed >= 130.0) {
                        ticketed.put(plate, true); // Rule 1: single segment ≥ 130
                    } else if (speed >= 120.0) {
                        int cnt = over120Count.get(plate) + 1;
                        over120Count.put(plate, cnt);
                        if (cnt >= 2) ticketed.put(plate, true); // Rule 2: two segments ≥ 120
                    }
                }

                prevTime.put(plate, e.getTimestamp());
                prevLocation.put(plate, e.getLocation());

                if (type.equals("EXIT") && ticketed.get(plate)) tickets.add(plate);
            }
        }
        return tickets;
    }
}

