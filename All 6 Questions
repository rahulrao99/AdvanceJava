  PROBLEM STATEMENT

  TASK 1 (Bug Fix): getBalance(accountId)
    BUG: No accountId filter — all accounts' transactions summed.
    FIX: Add "if (tx.accountId == accountId)" filter inside loop.

  TASK 2: getAverageTransactionAmountByAccount()
    Return {accountId → average amount}. Both CREDIT and DEBIT count.
    Accounts with 0 transactions must NOT appear in result.

  TASK 3: getTransactionFees()
    First 3 transactions FREE. 4th+ → CREDIT=$1, DEBIT=$2.
    CRITICAL: Sort by timestamp first — input may be out of order!
 └─────────────────────────────────────────────────────────────────┘
*/

// ══════════════════════════════════════════════════════════════════
//  SUPPORTING CLASSES
// ══════════════════════════════════════════════════════════════════

// Enum: two types of transactions
enum TransactionType {
    CREDIT, // money comes IN  → balance increases
    DEBIT   // money goes OUT  → balance decreases
}

// Transaction: one movement of money in or out of an account
class Transaction {
    int transactionId, accountId;
    TransactionType type;
    double amount;     // always positive
    long timestampSec; // when it happened (unix seconds)

    Transaction(int tid, int aid, TransactionType type, double amount, long ts) {
        this.transactionId = tid; this.accountId = aid;
        this.type = type; this.amount = amount; this.timestampSec = ts;
    }
    public int getAccountId()        { return accountId; }
    public TransactionType getType() { return type; }
    public double getAmount()        { return amount; }
    public long getTimestampSec()    { return timestampSec; }
}

// AccountManager: manages all transactions and provides 3 query methods
class AccountManager {
    List<Transaction> transactions = new ArrayList<>();

    void addTransaction(Transaction tx) { transactions.add(tx); }

    // ── TASK 1 (Bug Fix): getBalance(accountId) ───────────────────
    // BUG: no accountId filter — all transactions summed for every account
    // FIX: if (tx.accountId == accountId) — only count this account's txns
    public double getBalance(int accountId) {
        double balance = 0.0;
        for (Transaction tx : transactions) {
            if (tx.accountId == accountId) { // FIX: filter by accountId
                if (tx.type == TransactionType.CREDIT) balance += tx.amount;
                else balance -= tx.amount;
            }
        }
        return balance;
    }

    // ── TASK 2: getAverageTransactionAmountByAccount() ────────────
    // Two maps (sum + count) → divide at end. No status filter needed.
    public Map<Integer, Double> getAverageTransactionAmountByAccount() {
        Map<Integer, Double>  sumMap   = new HashMap<>();
        Map<Integer, Integer> countMap = new HashMap<>();

        for (Transaction tx : transactions) {
            sumMap.put(tx.getAccountId(),
                sumMap.getOrDefault(tx.getAccountId(), 0.0) + tx.getAmount());
            countMap.put(tx.getAccountId(),
                countMap.getOrDefault(tx.getAccountId(), 0) + 1);
        }

        Map<Integer, Double> result = new HashMap<>();
        for (int id : sumMap.keySet()) {
            result.put(id, sumMap.get(id) / countMap.get(id));
        }
        return result;
    }

    // ── TASK 3: getTransactionFees() ──────────────────────────────
    // Step 1: Group by accountId using computeIfAbsent
    // Step 2: Sort each account's list by timestamp — CRITICAL
    // Step 3: Loop with index, apply fees from index 3 onward
    public Map<Integer, Double> getTransactionFees() {

        // STEP 1: Group transactions by accountId
        Map<Integer, List<Transaction>> txByAccount = new HashMap<>();
        for (Transaction tx : transactions) {
            // computeIfAbsent: creates new list if key absent, returns existing list if present
            txByAccount.computeIfAbsent(tx.getAccountId(), k -> new ArrayList<>()).add(tx);
        }

        Map<Integer, Double> fees = new HashMap<>();

        for (Map.Entry<Integer, List<Transaction>> entry : txByAccount.entrySet()) {
            List<Transaction> accountTxs = entry.getValue();

            // STEP 2: Sort by timestamp — without this, out-of-order input gives wrong fees
            // Comparator.comparingLong: sorts numerically by getTimestampSec() value
            accountTxs.sort(Comparator.comparingLong(Transaction::getTimestampSec));

            // STEP 3: Apply fee rules using index
            double totalFee = 0.0;
            for (int i = 0; i < accountTxs.size(); i++) {
                if (i >= 3) { // index 0,1,2 = FREE. index 3+ = billable
                    Transaction tx = accountTxs.get(i);
                    totalFee += (tx.getType() == TransactionType.CREDIT) ? 1.0 : 2.0;
                }
            }
            fees.put(entry.getKey(), totalFee);
        }
        return fees;
    }
}

