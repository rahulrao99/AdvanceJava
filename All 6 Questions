  TASK 1 (Bug Fix): getMaxPrice() / getMinPrice() / getAvgPrice()
    All 3 crash when priceRecords is EMPTY:
    - getMaxPrice/getMinPrice: .getAsInt() on empty OptionalInt → NoSuchElementException
    - getAvgPrice: total / size when size=0 → ArithmeticException
    FIX: Add "if (priceRecords.isEmpty()) return -1" at top of each method.

  TASK 2: getBiggestChange()
    Return Object[]{change, earlierDate, laterDate} for the pair of
    consecutive days with the biggest absolute price change.
    KEY: "YYYY-MM-DD" strings sort alphabetically = chronologically.
    Return null if fewer than 2 records.
 └─────────────────────────────────────────────────────────────────┘
*/

// ══════════════════════════════════════════════════════════════════
//  SUPPORTING CLASSES
// ══════════════════════════════════════════════════════════════════

// Stock: identifies one company's stock by symbol and name
class Stock {
    String symbol, name;
    Stock(String sym, String name) { this.symbol=sym; this.name=name; }
    @Override public boolean equals(Object o) {
        if (!(o instanceof Stock)) return false;
        Stock s = (Stock) o;
        return symbol.equals(s.symbol) && name.equals(s.name);
    }
    @Override public int hashCode() { return Objects.hash(symbol, name); }
}

// PriceRecord: one price data point — stock, price, date
// Date format "YYYY-MM-DD" → alphabetical sort = chronological sort
class PriceRecord {
    Stock stock; int price; String date;
    PriceRecord(Stock s, int p, String d) { stock=s; price=p; date=d; }
}

// StockCollection: manages all price records for one stock
class StockCollection {
    List<PriceRecord> priceRecords = new ArrayList<>();
    Stock stock;
    StockCollection(Stock s) { stock=s; }

    void addPriceRecord(PriceRecord pr) {
        if (!pr.stock.equals(stock)) throw new IllegalArgumentException("Stock mismatch");
        priceRecords.add(pr);
    }
    int getNumPriceRecords() { return priceRecords.size(); }

    // ── TASK 1 (Bug Fix): getMaxPrice() ───────────────────────────
    // BUG: .max().getAsInt() crashes with NoSuchElementException when list is empty
    // FIX: check isEmpty() first → return -1 as sentinel value
    int getMaxPrice() {
        if (priceRecords.isEmpty()) return -1;
        return priceRecords.stream().mapToInt(r -> r.price).max().getAsInt();
    }

    // ── TASK 1 (Bug Fix): getMinPrice() ───────────────────────────
    // Same bug and fix as getMaxPrice — just using .min()
    int getMinPrice() {
        if (priceRecords.isEmpty()) return -1;
        return priceRecords.stream().mapToInt(r -> r.price).min().getAsInt();
    }

    // ── TASK 1 (Bug Fix): getAvgPrice() ───────────────────────────
    // BUG: total / priceRecords.size() crashes with division by zero when empty
    // FIX: return -1.0 if empty
    double getAvgPrice() {
        if (priceRecords.isEmpty()) return -1.0;
        double total = priceRecords.stream().mapToInt(r -> r.price).sum();
        return total / priceRecords.size();
    }

    // ── TASK 2: getBiggestChange() ─────────────────────────────────
    // Sort by date string (YYYY-MM-DD sorts alphabetically = chronologically)
    // Compare consecutive pairs, track biggest absolute change
    Object[] getBiggestChange() {
        if (priceRecords.size() < 2) return null;

        List<PriceRecord> sorted = new ArrayList<>(priceRecords);
        sorted.sort((r1, r2) -> r1.date.compareTo(r2.date)); // string sort = date sort

        // Initialise with first pair (0 and 1)
        int biggestChange = sorted.get(1).price - sorted.get(0).price;
        String earlierDate = sorted.get(0).date;
        String laterDate   = sorted.get(1).date;

        // Check remaining consecutive pairs
        for (int i = 1; i < sorted.size() - 1; i++) {
            int change = sorted.get(i+1).price - sorted.get(i).price;
            // Compare ABSOLUTE values — biggest magnitude wins
            if (Math.abs(change) > Math.abs(biggestChange)) {
                biggestChange = change;
                earlierDate   = sorted.get(i).date;
                laterDate     = sorted.get(i+1).date;
            }
        }
        return new Object[]{biggestChange, earlierDate, laterDate};
    }
}

