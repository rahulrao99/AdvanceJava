    FIX: .filter(r -> r.complete) before finding minimum.

  TASK 2: bestOfBests()
    Best time per obstacle across ALL runs (even incomplete), summed.
    KEY: guard with "run.obstacleTimes.size() > i" before accessing index i.

  TASK 3: chanceOfPersonalBest(inProgress)
    Monte Carlo simulation — 10,000 trials using random historical times.
    Returns probability (0.0–1.0) of beating personal best.
 └─────────────────────────────────────────────────────────────────┘
*/

// ══════════════════════════════════════════════════════════════════
//  SUPPORTING CLASSES
// ══════════════════════════════════════════════════════════════════

// Course: name and total obstacle count for one obstacle course
class Course {
    String title;
    int obstacleCount;
    Course(String title, int count) { this.title=title; this.obstacleCount=count; }
    @Override public boolean equals(Object o) {
        if (!(o instanceof Course)) return false;
        Course c = (Course) o;
        return c.title.equals(this.title) && c.obstacleCount == this.obstacleCount;
    }
    @Override public int hashCode() { return title.hashCode() * obstacleCount; }
}

// Run: one attempt at completing the obstacle course
class Run {
    Course course;
    boolean complete;                // true only when ALL obstacles are done
    List<Integer> obstacleTimes;     // times recorded so far

    Run(Course c) { course=c; complete=false; obstacleTimes=new ArrayList<>(); }

    // addObstacleTime: records next obstacle's time; marks complete when all N done
    void addObstacleTime(int t) {
        if (complete) throw new IllegalStateException("run is full");
        obstacleTimes.add(t);
        if (obstacleTimes.size() == course.obstacleCount) complete = true;
    }

    // getRunTime: sum of all recorded obstacle times (partial if incomplete)
    int getRunTime() { return obstacleTimes.stream().mapToInt(Integer::intValue).sum(); }
}

// RunCollection: manages all runs for one course and provides query methods
class RunCollection {
    Course course;
    List<Run> runs = new ArrayList<>();
    RunCollection(Course c) { course=c; }

    void addRun(Run run) {
        if (!run.course.equals(course)) throw new IllegalArgumentException("Course mismatch");
        runs.add(run);
    }
    int getNumRuns() { return runs.size(); }

    // ── TASK 1 (Bug Fix): personalBest() ──────────────────────────
    // BUG: no filter → incomplete runs (smaller totals) incorrectly win
    // FIX Option 1 (Stream): .filter(r -> r.complete)
    public int personalBest() {
        return runs.stream()
            .filter(r -> r.complete)       // FIX: only COMPLETE runs
            .mapToInt(r -> r.getRunTime())
            .min()
            .orElse(Integer.MAX_VALUE);    // no complete runs → return MAX
    }

    // FIX Option 2 (For loop): easier to write under interview pressure
    public int personalBest_ForLoop() {
        int best = Integer.MAX_VALUE;
        for (Run run : runs) {
            if (!run.complete) continue;   // FIX: skip incomplete
            if (run.getRunTime() < best) best = run.getRunTime();
        }
        return best;
    }

    // ── TASK 2: bestOfBests() ─────────────────────────────────────
    // Outer loop = obstacle position, inner loop = each run.
    // GUARD: "run.obstacleTimes.size() > i" prevents IndexOutOfBoundsException
    public int bestOfBests() {
        int total = 0;
        for (int i = 0; i < course.obstacleCount; i++) {
            int obstacleMin = Integer.MAX_VALUE;
            for (Run run : runs) {
                if (run.obstacleTimes.size() > i) { // GUARD: only if run reached obstacle i
                    obstacleMin = Math.min(obstacleMin, run.obstacleTimes.get(i));
                }
            }
            total += obstacleMin;
        }
        return total;
    }

    // ── TASK 3: chanceOfPersonalBest(inProgress) ──────────────────
    // Monte Carlo: build historical data → 10,000 random simulations → count successes
    public double chanceOfPersonalBest(Run inProgress) {
        int personalBest = personalBest();
        int totalObstacles = course.obstacleCount;

        // Build historical data: historical.get(i) = all known times for obstacle i
        List<List<Integer>> historical = new ArrayList<>();
        for (int i = 0; i < totalObstacles; i++) historical.add(new ArrayList<>());
        for (Run run : runs)
            for (int i = 0; i < run.obstacleTimes.size(); i++)
                historical.get(i).add(run.obstacleTimes.get(i));

        int currentTotal       = inProgress.getRunTime();
        int completedObstacles = inProgress.obstacleTimes.size();

        if (currentTotal > personalBest) return 0.0; // already over best → 0%

        int trials=10000, success=0;
        Random random = new Random();

        for (int t = 0; t < trials; t++) {
            int simTotal = currentTotal;
            for (int j = completedObstacles; j < totalObstacles; j++) {
                // Pick a random historical time for obstacle j
                simTotal += historical.get(j).get(random.nextInt(historical.get(j).size()));
                if (simTotal > personalBest) break; // this trial failed → stop early
            }
            if (simTotal <= personalBest) success++; // trial beat personal best
        }

        return success / (double) trials; // probability = successes / total trials
    }
}

