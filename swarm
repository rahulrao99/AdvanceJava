"""
Week 3 Assignment — Coder-Reviewer Swarm with Memory Injection
================================================================

A two-agent LangGraph swarm:
    coder_agent (entry) -> reviewer_agent -> [END | coder_agent | graceful_degrader]

Set DEMO_MODE=True to run with scripted responses (guarantees a reproducible
REJECTED -> retry -> APPROVED trace for submission evidence, no API calls needed).
Set DEMO_MODE=False to use a real OpenAI model via langchain-openai, reading
OPENAI_API_KEY from a .env file.
"""

import os
import sys
from typing import TypedDict, Optional, Literal

from dotenv import load_dotenv
from langgraph.graph import StateGraph, END

load_dotenv()  # loads OPENAI_API_KEY from .env, never hardcoded

# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------

DEMO_MODE = os.getenv("DEMO_MODE", "true").lower() == "true"
MAX_ITERATIONS = 2  # configurable, >= 2 per assignment spec

if not DEMO_MODE:
    from langchain_openai import ChatOpenAI
    llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)


# --------------------------------------------------------------------------
# State
# --------------------------------------------------------------------------

class SwarmState(TypedDict):
    feature_request: str
    architecture_guidelines: str
    codebase_context: str
    current_code: str
    review_feedback: Optional[str]
    verdict: Optional[str]
    iteration_count: int
    max_iterations: int
    status: Optional[str]


# --------------------------------------------------------------------------
# Mock codebase context (module index / AST summary) — Memory injection
# --------------------------------------------------------------------------

CODEBASE_CONTEXT = """\
Existing module index (mock_buggy_repo):
- utils/validators.py
    def validate_currency_code(code: str) -> bool
    def validate_iso_timestamp(ts: str) -> bool
- utils/formatting.py
    def round_currency(amount: float, decimals: int = 2) -> float
- models/transaction.py
    class Transaction (TypedDict): amount: float, currency: str, timestamp: str

Conventions used across this repo:
- All public functions use snake_case and full type hints
- Currency lists are always returned sorted alphabetically
- Domain errors use ValueError/KeyError, never bare except
"""


# --------------------------------------------------------------------------
# System prompts — intentionally distinct content (rubric 1.1, 10 pts)
# --------------------------------------------------------------------------

CODER_SYSTEM_PROMPT = """You are a Python Coder agent working inside an existing codebase.

Codebase context (existing modules/conventions to stay consistent with):
{codebase_context}

Feature request:
{feature_request}

Architecture guidelines your code will be reviewed against:
{architecture_guidelines}
{feedback_section}
Output ONLY the complete Python code for the function (including imports),
nothing else. No markdown fences, no commentary.
"""

REVIEWER_SYSTEM_PROMPT = """You are a strict code Reviewer agent. Check the code below
against EVERY guideline listed. A single violation means REJECTED.

Architecture guidelines:
{architecture_guidelines}

Code to review:
{current_code}

Respond in EXACTLY this format:
[REVIEWER] Verdict: APPROVED
or
[REVIEWER] Verdict: REJECTED
Feedback: <one specific violation per line>
"""


# --------------------------------------------------------------------------
# Demo-mode scripted responses (guarantees a REJECTED -> APPROVED trace)
# --------------------------------------------------------------------------

