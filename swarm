_DEMO_REVIEW_V1 = """[REVIEWER] Verdict: REJECTED
Feedback: Missing type hints on the 'transactions' parameter and return value.
Feedback: Missing a docstring describing the function, its parameters, return value, and exceptions raised."""

_DEMO_REVIEW_V2 = """[REVIEWER] Verdict: APPROVED"""


# --------------------------------------------------------------------------
# Agent nodes
# --------------------------------------------------------------------------

def coder_agent(state: SwarmState) -> SwarmState:
    iteration = state["iteration_count"]
    print(f"\n[CODER] Iteration {iteration + 1}")

    feedback_section = ""
    if state.get("review_feedback"):
        feedback_section = f"\nThe previous attempt was REJECTED. Fix these issues:\n{state['review_feedback']}\n"

    if DEMO_MODE:
        code = _DEMO_CODE_V1 if iteration == 0 else _DEMO_CODE_V2
    else:
        prompt = CODER_SYSTEM_PROMPT.format(
            codebase_context=state["codebase_context"],
            feature_request=state["feature_request"],
            architecture_guidelines=state["architecture_guidelines"],
            feedback_section=feedback_section,
        )
        response = llm.invoke(prompt)
        code = response.content.strip()

    print(code)

    return {
        **state,
        "current_code": code,
    }


def reviewer_agent(state: SwarmState) -> SwarmState:
    iteration = state["iteration_count"]

    if DEMO_MODE:
        review = _DEMO_REVIEW_V1 if iteration == 0 else _DEMO_REVIEW_V2
    else:
        prompt = REVIEWER_SYSTEM_PROMPT.format(
            architecture_guidelines=state["architecture_guidelines"],
            current_code=state["current_code"],
        )
        response = llm.invoke(prompt)
        review = response.content.strip()

    print(f"\n{review}")

    verdict = "APPROVED" if "APPROVED" in review.splitlines()[0] else "REJECTED"
    feedback = None
    if verdict == "REJECTED":
        feedback_lines = [
            line.replace("Feedback:", "").strip()
            for line in review.splitlines()
            if line.strip().startswith("Feedback:")
        ]
        feedback = "\n".join(feedback_lines)

    return {
        **state,
        "verdict": verdict,
        "review_feedback": feedback,
        "iteration_count": iteration + 1,  # increments after Reviewer run, not Coder run
    }


def graceful_degrader(state: SwarmState) -> SwarmState:
    print("\n[GRACEFUL_DEGRADER] Max iterations reached — escalating to human engineer")
    report = f"""
=== ESCALATION REPORT ===
Iterations attempted: {state['iteration_count']} / {state['max_iterations']}
Last reviewer feedback:
{state['review_feedback']}

Last code preview (first 10 lines):
{chr(10).join(state['current_code'].splitlines()[:10])}
=========================
"""
    print(report)
    return {
        **state,
        "status": "ESCALATED",
    }


# --------------------------------------------------------------------------
# Conditional routing — 3 destinations: END / coder_agent / graceful_degrader
# --------------------------------------------------------------------------

def route_after_review(state: SwarmState) -> Literal["approved", "retry", "escalate"]:
    if state["verdict"] == "APPROVED":
        return "approved"
    if state["iteration_count"] >= state["max_iterations"]:
        return "escalate"
    return "retry"


# --------------------------------------------------------------------------
# Graph construction
# --------------------------------------------------------------------------

def build_graph():
    graph = StateGraph(SwarmState)

    graph.add_node("coder_agent", coder_agent)
    graph.add_node("reviewer_agent", reviewer_agent)
    graph.add_node("graceful_degrader", graceful_degrader)

    graph.set_entry_point("coder_agent")  # entry point must be coder_agent (rubric 1.3)

    graph.add_edge("coder_agent", "reviewer_agent")

    graph.add_conditional_edges(
        "reviewer_agent",
        route_after_review,
        {
            "approved": END,
            "retry": "coder_agent",
            "escalate": "graceful_degrader",
        },
    )

    graph.add_edge("graceful_degrader", END)

    return graph.compile()


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

def main():
    with open("feature_request.txt", "r") as f:
        feature_request = f.read()
    with open("architecture_guidelines.md", "r") as f:
        architecture_guidelines = f.read()

    initial_state: SwarmState = {
        "feature_request": feature_request,
        "architecture_guidelines": architecture_guidelines,
        "codebase_context": CODEBASE_CONTEXT,
        "current_code": "",
        "review_feedback": None,
        "verdict": None,
        "iteration_count": 0,
        "max_iterations": MAX_ITERATIONS,
        "status": None,
    }

    print(f"{'='*60}\nRunning swarm (DEMO_MODE={DEMO_MODE}, max_iterations={MAX_ITERATIONS})\n{'='*60}")

    swarm = build_graph()
    final_state = swarm.invoke(initial_state)

    final_status = final_state.get("status") or final_state.get("verdict")
    print(f"\n{'='*60}\nFINAL STATUS: {final_status}\n{'='*60}")

    return final_state


if __name__ == "__main__":
    main()
